# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your Firebase project values.
# `.env.local` is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# === Firebase client SDK (browser) =========================================
# Firebase console → Project settings → General → Your apps → Web app → Config.
# These are PUBLIC identifiers, not secrets. Access is controlled by
# firestore.rules and storage.rules, not by hiding these values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# === Firebase Admin SDK (server) ===========================================
# Used by Server Components, the API routes and the seed scripts.
#
# In production on Firebase App Hosting / Cloud Run you can leave ALL of these
# blank — Application Default Credentials are injected automatically.
#
# For local development, download a service-account key from
# Firebase console → Project settings → Service accounts → Generate new key,
# then use EITHER option A or option B below.

# --- Option A: paste the whole JSON on one line (or base64-encode it) ------
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# --- Option B: the three individual fields --------------------------------
# The private key contains newlines. Keep it in double quotes with literal
# \n sequences exactly as they appear in the downloaded JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Optional — defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
# FIREBASE_STORAGE_BUCKET=


# === Site ==================================================================
# The canonical origin. Used for canonical URLs, Open Graph tags, the sitemap
# and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# robots.txt blocks all crawlers unless this is "true" AND the build is
# production. Set it to "true" only on the real production domain, so staging
# and preview deployments never get indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false


# === Google reCAPTCHA (contact form) =======================================
# Create a v3 site at https://www.google.com/recaptcha/admin
# If the secret is left blank, verification is SKIPPED and a warning is logged.
# Always set it in production.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Minimum v3 score to accept, 0.0–1.0. Default 0.5. Raise it if you get spam.
# RECAPTCHA_MIN_SCORE=0.5


# === AI website assistant (chat widget) ====================================
# Get a key from https://console.anthropic.com → API keys.
#
# WITHOUT this key the chat widget still works, but in "basic mode": it
# keyword-matches answers from your own site content instead of generating
# them, and says so in the panel. Set the key to enable the full assistant.
#
# Server-side only — never prefix this with NEXT_PUBLIC_, or the key ships to
# the browser and anyone can spend against it.
ANTHROPIC_API_KEY=


# === Seed scripts ==========================================================
# Used by `npm run create-admin` when you don't pass CLI arguments.
# SEED_ADMIN_EMAIL=admin@yourcompany.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Site Administrator
